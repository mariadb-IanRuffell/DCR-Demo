# Single source of truth for the 3 simulated data centres.
# DCn_HOST_IP is the LAN address other DCs use to reach this DC's published ports.
# Leave MAC_IP/LLAMA_IP empty to auto-detect (en0 / ssh llama.local).
LLAMA_HOST=llama.local
MAC_IP=
LLAMA_IP=
# id|display name|host (mac|llama)|index
DCS="dc1|London|mac|1 dc2|Frankfurt|llama|2 dc3|New_York|llama|3"
GG_IMAGE=gridgain/gridgain9:9.2.0-b1
INITIAL_NODES=3
MAX_NODES=5
